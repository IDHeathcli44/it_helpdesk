{
  "name": "it-helpdesk-node",
  "version": "0.3.1",
  "private": true,
  "description": "Editable IT HelpDesk with tickets, reports, equipment inventory and notifications",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:local": "node src/server.js",
    "start:dev": "node scripts/start-development.js",
    "dev": "node --watch scripts/start-development.js",
    "db:dev:init": "node scripts/init-development-database.js",
    "check": "npm run check:syntax && npm test",
    "check:syntax": "node scripts/check-syntax.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "multer": "^2.4.0",
    "socket.io": "^4.8.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
