<%- include('../partials/head', { title: 'Обладнання' }) %>
  <%- include('../partials/nav') %>
    <main class="container">
      <div class="page-title">
        <div>
          <h1>Обладнання</h1>
          <p>Комп’ютери, принтери та інша техніка підприємства.</p>
        </div><a class="btn btn-primary add-equipment-button" href="/equipment/new">
          <span class="button-icon">+</span>
          Додати обладнання
        </a>
      </div>
      <%- include('../partials/flash') %>
        <section class="stats-grid compact-stats">
          <article class="stat-card"><span>Усього</span><strong>
              <%= stats.total || 0 %>
            </strong></article>
          <article class="stat-card"><span>Комп’ютери</span><strong>
              <%= stats.computers || 0 %>
            </strong></article>
          <article class="stat-card"><span>Принтери</span><strong>
              <%= stats.printers || 0 %>
            </strong></article>
          <article class="stat-card"><span>У ремонті</span><strong>
              <%= stats.repair || 0 %>
            </strong></article>
        </section>
        <section class="card">
          <form class="filter-bar" method="get">
            <input name="search" value="<%= search %>" placeholder="Пошук за назвою, IP, серійним номером...">
            <select name="type">
              <option value="">Усі типи</option>
              <% Object.entries(types).forEach(([v,l])=>{ %><option value="<%= v %>" <%=type===v?'selected':'' %>><%= l
                    %>
                </option>
                <% }) %>
            </select>
            <select name="status">
              <option value="">Усі статуси</option>
              <% Object.entries(statuses).forEach(([v,l])=>{ %><option value="<%= v %>" <%=status===v?'selected':'' %>>
                  <%= l %>
                </option>
                <% }) %>
            </select>
            <button class="secondary" type="submit">Фільтрувати</button>
          </form>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Обладнання</th>
                  <th>Інв. №</th>
                  <th>Користувач</th>
                  <th>Місце</th>
                  <th>IP</th>
                  <th>Статус</th>
                  <th>Заявки</th>
                </tr>
              </thead>
              <tbody>
                <% equipment.forEach(item=>{ %><tr>
                    <td><a href="/equipment/<%= item.id %>"><strong>
                          <%= item.name %>
                        </strong></a><small class="table-sub">
                        <%= types[item.type] %> · <%= [item.manufacturer,item.model].filter(Boolean).join(' ') || ' —'
                            %>
                      </small></td>
                    <td>
                      <%= item.asset_tag || '—' %>
                    </td>
                    <td>
                      <%= item.assigned_user_name || 'Не призначено' %>
                    </td>
                    <td>
                      <%= [item.department,item.office].filter(Boolean).join(', ') || ' —' %>
                    </td>
                    <td>
                      <%= item.ip_address || '—' %>
                    </td>
                    <td><span class="badge equipment-<%= item.status %>">
                        <%= statuses[item.status] %>
                      </span></td>
                    <td>
                      <%= item.ticket_count %>
                    </td>
                  </tr>
                  <% }) %>
                    <% if(!equipment.length){ %>
                      <tr>
                        <td colspan="7" class="empty-cell">Обладнання не знайдено.</td>
                      </tr>
                      <% } %>
              </tbody>
            </table>
          </div>
        </section>
    </main><%- include('../partials/footer') %>