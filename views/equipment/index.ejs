<%- include('../partials/head', { title: t('Обладнання') }) %>
  <% const equipmentImportErrors = typeof importErrors === 'undefined' ? [] : importErrors; %>
  <%- include('../partials/nav') %>
    <main class="container">
      <div class="page-title equipment-page-title">
        <div>
          <h1><%= t('Обладнання') %></h1>
          <p><%= t('Комп’ютери, принтери та інша техніка підприємства.') %></p>
        </div>
      </div>
      <div class="inventory-export-actions">
        <a class="button primary" href="/equipment/export.xlsx?<%= new URLSearchParams({ type, status, search }).toString() %>"><%= t('Вивантажити інвентаризацію Excel') %></a>
        <span class="muted"><%= t('Вивантаження враховує вибрані фільтри.') %></span>
        <% if (!permissions.manageEquipment) { %><span class="badge"><%= t('Лише перегляд') %></span><% } %>
      </div>
      <% if (permissions.manageEquipment) { %>
      <section class="equipment-actions" aria-label="<%= t('Дії з обладнанням') %>">
          <a class="secondary-button equipment-action-button template-download-button" href="/equipment/import-template.xlsx">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3v12"></path>
              <path d="m7 10 5 5 5-5"></path>
              <path d="M5 21h14"></path>
            </svg>
            <span><%= t('Завантажити шаблон Excel') %></span>
          </a>
          <form action="/equipment/import" method="post" enctype="multipart/form-data" class="equipment-import-form">
            <label class="inventory-file-picker" for="inventoryFile">
              <input id="inventoryFile" type="file" name="inventoryFile" accept=".xlsx,.xls,.csv" required>
              <span class="inventory-file-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <path d="M14 2v6h6"></path>
                </svg>
              </span>
              <span class="inventory-file-copy">
                <strong><%= t('Файл інвентаризації') %></strong>
                <small id="inventoryFileName"><%= t('XLSX, XLS або CSV · до 10 МБ') %></small>
              </span>
              <span class="inventory-file-trigger"><%= t('Обрати') %></span>
            </label>
            <button class="primary equipment-action-button" type="submit">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 21V9"></path>
                <path d="m7 14 5-5 5 5"></path>
                <path d="M5 3h14"></path>
              </svg>
              <span><%= t('Імпортувати обладнання') %></span>
            </button>
          </form>
          <a class="btn btn-primary add-equipment-button" href="/equipment/new">
            <span class="button-icon">+</span>
            <%= t('Додати обладнання') %>
          </a>
      </section>
      <% } %>
      <%- include('../partials/flash') %>
        <% if (equipmentImportErrors.length) { %>
          <section class="card import-errors">
            <h2><%= t('Рядки, які не вдалося імпортувати') %></h2>
            <ul>
              <% equipmentImportErrors.forEach(error => { %><li><%= t(error) %></li><% }) %>
            </ul>
          </section>
        <% } %>
        <section class="stats-grid compact-stats">
          <article class="stat-card"><span><%= t('Резерв') %></span><strong><%= stats.reserve || 0 %></strong></article>
          <article class="stat-card"><span><%= t('Усього') %></span><strong>
              <%= stats.total || 0 %>
            </strong></article>
          <article class="stat-card"><span><%= t('Комп’ютери') %></span><strong>
              <%= stats.computers || 0 %>
            </strong></article>
          <article class="stat-card"><span><%= t('Принтери') %></span><strong>
              <%= stats.printers || 0 %>
            </strong></article>
          <article class="stat-card"><span><%= t('У ремонті') %></span><strong>
              <%= stats.repair || 0 %>
            </strong></article>
        </section>
        <section class="card">
          <form class="filter-bar" method="get">
            <input name="search" value="<%= search %>" placeholder="<%= t('Пошук за назвою, IP, серійним номером...') %>">
            <select name="type">
              <option value=""><%= t('Усі типи') %></option>
              <% Object.entries(types).forEach(([v,l])=>{ %><option value="<%= v %>" <%=type===v?'selected':'' %>><%= t(l) %>
                </option>
                <% }) %>
            </select>
            <select name="status">
              <option value=""><%= t('Усі статуси') %></option>
              <% Object.entries(statuses).forEach(([v,l])=>{ %><option value="<%= v %>" <%=status===v?'selected':'' %>>
                  <%= t(l) %>
                </option>
                <% }) %>
            </select>
            <button class="secondary" type="submit"><%= t('Фільтрувати') %></button>
          </form>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th><%= t('Обладнання') %></th>
                  <th><%= t('Інв. №') %></th>
                  <th><%= t('Користувач') %></th>
                  <th><%= t('Місце') %></th>
                  <th>IP</th>
                  <th><%= t('Статус') %></th>
                  <th><%= t('Заявки') %></th>
                </tr>
              </thead>
              <tbody>
                <% equipment.forEach(item=>{ %><tr>
                    <td><a href="/equipment/<%= item.id %>"><strong>
                          <%= item.name %>
                        </strong></a><small class="table-sub">
                        <%= t(types[item.type]) %> · <%= [item.manufacturer,item.model].filter(Boolean).join(' ') || ' —'
                            %>
                      </small></td>
                    <td>
                      <%= item.asset_tag || '—' %>
                    </td>
                    <td>
                      <%= item.assigned_user_name || t('Не призначено') %>
                    </td>
                    <td>
                      <%= [item.department,item.office].filter(Boolean).join(', ') || ' —' %>
                    </td>
                    <td>
                      <%= item.ip_address || '—' %>
                    </td>
                    <td><span class="badge equipment-<%= item.status %>">
                        <%= t(statuses[item.status]) %>
                      </span></td>
                    <td>
                      <%= item.ticket_count %>
                    </td>
                  </tr>
                  <% }) %>
                    <% if(!equipment.length){ %>
                      <tr>
                        <td colspan="7" class="empty-cell"><%= t('Обладнання не знайдено.') %></td>
                      </tr>
                      <% } %>
              </tbody>
            </table>
          </div>
        </section>
    </main><%- include('../partials/footer') %>
