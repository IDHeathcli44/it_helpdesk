<%- include('../partials/head', { title: item.name }) %><%- include('../partials/nav') %>
<main class="container"><div class="page-title"><div><a class="back-link" href="/equipment">← До обладнання</a><h1><%= item.name %></h1><p><%= types[item.type] %> · <%= item.asset_tag || 'без інвентарного номера' %></p></div><a class="secondary button-link" href="/equipment/<%= item.id %>/edit">Редагувати</a></div><%- include('../partials/flash') %>
<div class="detail-grid"><div><section class="card"><h2>Характеристики</h2><dl class="meta-grid"><div><dt>Статус</dt><dd><span class="badge equipment-<%= item.status %>"><%= statuses[item.status] %></span></dd></div><div><dt>Користувач</dt><dd><%= item.assigned_user_name || 'Не призначено' %></dd></div><div><dt>Виробник / модель</dt><dd><%= [item.manufacturer,item.model].filter(Boolean).join(' ') || '—' %></dd></div><div><dt>Серійний номер</dt><dd><%= item.serial_number || '—' %></dd></div><div><dt>IP / MAC</dt><dd><%= item.ip_address || '—' %> / <%= item.mac_address || '—' %></dd></div><div><dt>Місце</dt><dd><%= [item.department,item.office].filter(Boolean).join(', ') || '—' %></dd></div><div><dt>ОС</dt><dd><%= item.operating_system || '—' %></dd></div><div><dt>CPU / RAM</dt><dd><%= item.cpu || '—' %> / <%= item.ram_gb ? item.ram_gb+' ГБ':'—' %></dd></div><div><dt>Накопичувачі</dt><dd><%= item.storage || '—' %></dd></div></dl><% if(item.notes){ %><h3>Примітки</h3><p><%= item.notes %></p><% } %></section>
<section class="card"><h2>Історія заявок</h2><div class="table-wrap"><table><thead><tr><th>№</th><th>Тема</th><th>Статус</th><th>Створено</th></tr></thead><tbody><% tickets.forEach(t=>{ %><tr><td>#<%= t.id %></td><td><a href="/tickets/<%= t.id %>"><%= t.title %></a></td><td><%= t.status %></td><td><%= t.created_at %></td></tr><% }) %><% if(!tickets.length){ %><tr><td colspan="4" class="empty-cell">Заявок по цьому обладнанню ще немає.</td></tr><% } %></tbody></table></div></section></div>
<aside><section class="card danger-zone"><h2>Небезпечна зона</h2><p class="muted">Видалення прибере обладнання зі списку, але заявки залишаться.</p><form method="post" action="/equipment/<%= item.id %>/delete" onsubmit="return confirm('Видалити обладнання?')"><button class="danger" type="submit">Видалити</button></form></section></aside></div></main><%- include('../partials/footer') %>
