<%- include('../partials/head', { title: item.name }) %><%- include('../partials/nav') %>
<main class="container"><div class="page-title"><div><a class="back-link" href="/equipment"><%= t('← До обладнання') %></a><h1><%= item.name %></h1><p><%= t(types[item.type]) %> · <%= item.asset_tag || t('без інвентарного номера') %></p></div><% if (permissions.manageEquipment) { %><a class="button secondary-button" href="/equipment/<%= item.id %>/edit"><%= t('Редагувати') %></a><% } else { %><span class="badge"><%= t('Лише перегляд') %></span><% } %></div><%- include('../partials/flash') %>
<div class="detail-grid"><div><section class="card"><h2><%= t('Характеристики') %></h2><dl class="meta-grid"><div><dt><%= t('Статус') %></dt><dd><span class="badge equipment-<%= item.status %>"><%= t(statuses[item.status]) %></span></dd></div><div><dt><%= t('Користувач') %></dt><dd><%= item.assigned_user_name || t('Не призначено') %></dd></div><div><dt><%= t('Виробник / модель') %></dt><dd><%= [item.manufacturer,item.model].filter(Boolean).join(' ') || '—' %></dd></div><div><dt><%= t('Серійний номер') %></dt><dd><%= item.serial_number || '—' %></dd></div><div><dt>IP / MAC</dt><dd><%= item.ip_address || '—' %> / <%= item.mac_address || '—' %></dd></div><div><dt><%= t('Місце') %></dt><dd><%= [item.department,item.office].filter(Boolean).join(', ') || '—' %></dd></div><div><dt><%= t('ОС') %></dt><dd><%= item.operating_system || '—' %></dd></div><div><dt>CPU / RAM</dt><dd><%= item.cpu || '—' %> / <%= item.ram_gb ? t('{size} ГБ', { size: item.ram_gb }):'—' %></dd></div><div><dt><%= t('Накопичувачі') %></dt><dd><%= item.storage || '—' %></dd></div></dl><% if(item.notes){ %><h3><%= t('Примітки') %></h3><p><%= item.notes %></p><% } %></section>
<section class="card"><h2><%= t('Історія заявок') %></h2><div class="table-wrap"><table><thead><tr><th>№</th><th><%= t('Тема') %></th><th><%= t('Статус') %></th><th><%= t('Створено') %></th></tr></thead><tbody><% tickets.forEach(ticket=>{ %><tr><td>#<%= ticket.id %></td><td><a href="/tickets/<%= ticket.id %>"><%= ticket.title %></a></td><td><%= t(ticketStatusLabels[ticket.status] || ticket.status) %></td><td><%= ticket.created_at %></td></tr><% }) %><% if(!tickets.length){ %><tr><td colspan="4" class="empty-cell"><%= t('Заявок по цьому обладнанню ще немає.') %></td></tr><% } %></tbody></table></div></section></div>
<% if (permissions.manageEquipment) { %><aside><section class="card danger-zone"><h2><%= t('Небезпечна зона') %></h2><p class="muted"><%= t('Видалення прибере обладнання зі списку, але заявки залишаться.') %></p><form method="post" action="/equipment/<%= item.id %>/delete" data-confirm="<%= t('Видалити обладнання?') %>" onsubmit="return confirm(this.dataset.confirm)"><button class="danger" type="submit"><%= t('Видалити') %></button></form></section></aside><% } %></div></main><%- include('../partials/footer') %>
