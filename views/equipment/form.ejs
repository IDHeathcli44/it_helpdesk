<%- include('../partials/head', { title: t(item ? 'Редагування обладнання' : 'Нове обладнання') }) %><%- include('../partials/nav') %>
<main class="container"><div class="page-title"><div><a class="back-link" href="/equipment"><%= t('← До обладнання') %></a><h1><%= t(item ? 'Редагувати обладнання' : 'Додати обладнання') %></h1></div></div><%- include('../partials/flash') %>
<section class="card"><form class="form-grid" method="post" action="<%= item ? '/equipment/'+item.id : '/equipment' %>">
<div class="form-row"><label><%= t('Тип') %><select name="type"><% Object.entries(types).forEach(([v,l])=>{ %><option value="<%= v %>" <%= (item?.type||'computer')===v?'selected':'' %>><%= t(l) %></option><% }) %></select></label><label><%= t('Назва') %><input required name="name" value="<%= item?.name || '' %>" placeholder="<%= t('Наприклад: ПК бухгалтерії 01') %>"></label><label><%= t('Інвентарний номер') %><input name="assetTag" value="<%= item?.asset_tag || '' %>"></label></div>
<div class="form-row"><label><%= t('Виробник') %><input name="manufacturer" value="<%= item?.manufacturer || '' %>"></label><label><%= t('Модель') %><input name="model" value="<%= item?.model || '' %>"></label><label><%= t('Серійний номер') %><input name="serialNumber" value="<%= item?.serial_number || '' %>"></label></div>
<div class="form-row"><label><%= t('IP-адреса') %><input name="ipAddress" value="<%= item?.ip_address || '' %>"></label><label><%= t('MAC-адреса') %><input name="macAddress" value="<%= item?.mac_address || '' %>"></label><label><%= t('Статус') %><select name="status"><% Object.entries(statuses).forEach(([v,l])=>{ %><option value="<%= v %>" <%= (item?.status||'active')===v?'selected':'' %>><%= t(l) %></option><% }) %></select></label></div>
<div class="form-row"><label><%= t('Користувач') %><select name="assignedUserId"><option value=""><%= t('Не призначено') %></option><% users.forEach(u=>{ %><option value="<%= u.id %>" <%= item?.assigned_user_id===u.id?'selected':'' %>><%= u.full_name %></option><% }) %></select></label><label><%= t('Відділ') %><input name="department" value="<%= item?.department || '' %>"></label><label><%= t('Кабінет') %><input name="office" value="<%= item?.office || '' %>"></label></div>
<div class="form-row"><label><%= t('Операційна система') %><input name="operatingSystem" value="<%= item?.operating_system || '' %>"></label><label><%= t('Процесор') %><input name="cpu" value="<%= item?.cpu || '' %>"></label><label><%= t('RAM, ГБ') %><input type="number" min="0" name="ramGb" value="<%= item?.ram_gb || '' %>"></label></div>
<label><%= t('Накопичувачі') %><input name="storage" value="<%= item?.storage || '' %>" placeholder="<%= t('SSD 512 ГБ + HDD 1 ТБ') %>"></label><label><%= t('Примітки') %><textarea name="notes" rows="4"><%= item?.notes || '' %></textarea></label>
<button class="primary" type="submit"><%= t('Зберегти') %></button></form></section></main><%- include('../partials/footer') %>
