<%- include('../partials/head', { title: item ? 'Редагування обладнання' : 'Нове обладнання' }) %><%- include('../partials/nav') %>
<main class="container"><div class="page-title"><div><a class="back-link" href="/equipment">← До обладнання</a><h1><%= item ? 'Редагувати обладнання' : 'Додати обладнання' %></h1></div></div><%- include('../partials/flash') %>
<section class="card"><form class="form-grid" method="post" action="<%= item ? '/equipment/'+item.id : '/equipment' %>">
<div class="form-row"><label>Тип<select name="type"><% Object.entries(types).forEach(([v,l])=>{ %><option value="<%= v %>" <%= (item?.type||'computer')===v?'selected':'' %>><%= l %></option><% }) %></select></label><label>Назва<input required name="name" value="<%= item?.name || '' %>" placeholder="Наприклад: ПК бухгалтерії 01"></label><label>Інвентарний номер<input name="assetTag" value="<%= item?.asset_tag || '' %>"></label></div>
<div class="form-row"><label>Виробник<input name="manufacturer" value="<%= item?.manufacturer || '' %>"></label><label>Модель<input name="model" value="<%= item?.model || '' %>"></label><label>Серійний номер<input name="serialNumber" value="<%= item?.serial_number || '' %>"></label></div>
<div class="form-row"><label>IP-адреса<input name="ipAddress" value="<%= item?.ip_address || '' %>"></label><label>MAC-адреса<input name="macAddress" value="<%= item?.mac_address || '' %>"></label><label>Статус<select name="status"><% Object.entries(statuses).forEach(([v,l])=>{ %><option value="<%= v %>" <%= (item?.status||'active')===v?'selected':'' %>><%= l %></option><% }) %></select></label></div>
<div class="form-row"><label>Користувач<select name="assignedUserId"><option value="">Не призначено</option><% users.forEach(u=>{ %><option value="<%= u.id %>" <%= item?.assigned_user_id===u.id?'selected':'' %>><%= u.full_name %></option><% }) %></select></label><label>Відділ<input name="department" value="<%= item?.department || '' %>"></label><label>Кабінет<input name="office" value="<%= item?.office || '' %>"></label></div>
<div class="form-row"><label>Операційна система<input name="operatingSystem" value="<%= item?.operating_system || '' %>"></label><label>Процесор<input name="cpu" value="<%= item?.cpu || '' %>"></label><label>RAM, ГБ<input type="number" min="0" name="ramGb" value="<%= item?.ram_gb || '' %>"></label></div>
<label>Накопичувачі<input name="storage" value="<%= item?.storage || '' %>" placeholder="SSD 512 ГБ + HDD 1 ТБ"></label><label>Примітки<textarea name="notes" rows="4"><%= item?.notes || '' %></textarea></label>
<button class="primary" type="submit">Зберегти</button></form></section></main><%- include('../partials/footer') %>
