<%- include('../partials/head', { title: t('Звіти') }) %>
<%- include('../partials/nav') %>

<main class="container">
  <div class="page-title">
    <div><h1><%= t('Звітність') %></h1><p><%= t('Показники роботи IT-відділу та швидкості виконання заявок.') %></p></div>
    <div class="report-actions" aria-label="<%= t('Керування звітами') %>">
      <a class="button primary button-link report-export-button" href="/reports/export.xlsx?period=<%= period %>">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3v12"></path>
          <path d="m7 10 5 5 5-5"></path>
          <path d="M5 21h14"></path>
        </svg>
        <span><%= t('Експорт в Excel') %></span>
      </a>
      <a class="secondary-button button-link report-csv-button" href="/reports/export.csv?period=<%= period %>">CSV</a>
      <form method="get" action="/reports" class="period-filter">
        <select name="period" aria-label="<%= t('Період звіту') %>" onchange="this.form.submit()">
          <option value="7" <%= period === '7' ? 'selected' : '' %>><%= t('7 днів') %></option>
          <option value="30" <%= period === '30' ? 'selected' : '' %>><%= t('30 днів') %></option>
          <option value="90" <%= period === '90' ? 'selected' : '' %>><%= t('90 днів') %></option>
          <option value="365" <%= period === '365' ? 'selected' : '' %>><%= t('Рік') %></option>
          <option value="all" <%= period === 'all' ? 'selected' : '' %>><%= t('Увесь час') %></option>
        </select>
      </form>
    </div>
  </div>

  <section class="stats-grid reports-stats">
    <article class="stat-card"><span><%= t('Створено') %></span><strong><%= summary.total || 0 %></strong></article>
    <article class="stat-card"><span><%= t('Виконано') %></span><strong><%= summary.completed || 0 %></strong></article>
    <article class="stat-card"><span><%= t('Відкрито') %></span><strong><%= summary.open || 0 %></strong></article>
    <article class="stat-card"><span><%= t('Середня реакція') %></span><strong class="metric-text"><%= formatDuration(summary.avg_response_minutes) %></strong></article>
    <article class="stat-card"><span><%= t('Середній час заявки') %></span><strong class="metric-text"><%= formatDuration(summary.avg_resolution_minutes) %></strong></article>
  </section>

  <div class="report-grid">
    <section class="card"><h2><%= t('За статусами') %></h2>
      <div class="bar-list">
        <% byStatus.forEach(item => { %><div><span><%= t(ticketStatusLabels[item.status] || item.status) %></span><progress value="<%= item.total %>" max="<%= summary.total || 1 %>"></progress><strong><%= item.total %></strong></div><% }) %>
      </div>
    </section>
    <section class="card"><h2><%= t('За категоріями') %></h2>
      <div class="bar-list">
        <% byCategory.forEach(item => { %><div><span><%= t(item.category) %></span><progress value="<%= item.total %>" max="<%= summary.total || 1 %>"></progress><strong><%= item.total %></strong></div><% }) %>
      </div>
    </section>
  </div>

  <section class="card table-wrap">
    <h2><%= t('Робота виконавців') %></h2>
    <table><thead><tr><th><%= t('Виконавець') %></th><th><%= t('Усього') %></th><th><%= t('Виконано') %></th><th><%= t('Середній час') %></th></tr></thead>
      <tbody><% byAssignee.forEach(item => { %><tr><td><%= item.assignee_id == null ? t('Не призначено') : item.assignee %></td><td><%= item.total %></td><td><%= item.completed %></td><td><%= formatDuration(item.avg_minutes) %></td></tr><% }) %></tbody>
    </table>
  </section>

  <section class="card"><h2><%= t('Останні 14 днів') %></h2>
    <div class="daily-grid">
      <% daily.forEach(item => { %><article><span><%= item.day %></span><strong><%= item.created %></strong><small><%= t('створено · {count} виконано', { count: item.completed }) %></small></article><% }) %>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
