<%- include('../partials/head', { title: t('Відновлення доступу') }) %>

<main class="auth-shell">
  <section class="auth-visual">
    <div class="auth-logo">
      <span class="brand-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
      </span>
      <span>IT HelpDesk</span>
    </div>
    <h2><%= t('Відновлення доступу') %></h2>
    <p><%= t('Заявка потрапить у спільну чергу адміністраторів та IT-спеціалістів.') %></p>
  </section>

  <section class="auth-form-area">
    <div class="card auth-card">
      <h1><%= t('Забули пароль?') %></h1>
      <p class="auth-intro"><%= t('Вкажіть логін. Перший вільний спеціаліст прийме заявку в роботу.') %></p>

      <%- include('../partials/flash') %>

      <form method="post" action="/forgot-password" class="form-grid">
        <label>
          <%= t('Логін') %>
          <input name="username" value="<%= loginUsername %>" required autocomplete="username" autocapitalize="none" spellcheck="false">
        </label>
        <button class="primary" type="submit"><%= t('Створити заявку') %></button>
      </form>

      <p class="auth-footer-link"><a href="/login"><%= t('← Повернутися до входу') %></a></p>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
