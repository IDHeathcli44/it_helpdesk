<%- include('../partials/head', { title: t('Вхід') }) %>

<main class="auth-shell">
  <section class="auth-visual">
    <div class="auth-logo">
      <span class="brand-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
      </span>
      <span>IT HelpDesk</span>
    </div>
    <h2><%= t('Зручний облік заявок без зайвих складнощів') %></h2>
    <p><%= t('Створюйте звернення, відстежуйте їхній стан і отримуйте допомогу IT-відділу в одному місці.') %></p>
  </section>

  <section class="auth-form-area">
    <div class="card auth-card">
      <h1><%= t('Вхід у систему') %></h1>
      <p class="auth-intro"><%= t('Введіть логін і пароль свого облікового запису.') %></p>

      <%- include('../partials/flash') %>

      <form method="post" action="/login" class="form-grid">
        <label>
          <%= t('Логін') %>
          <input name="username" value="<%= loginUsername %>" required autocomplete="username" autocapitalize="none" spellcheck="false">
        </label>

        <label>
          <%= t('Пароль') %>
          <input type="password" name="password" required autocomplete="current-password">
        </label>

        <button class="primary" type="submit"><%= t('Увійти') %></button>
      </form>

      <p class="auth-footer-link">
        <a href="/forgot-password"><%= t('Забули пароль?') %></a>
      </p>

      <p class="auth-footer-link">
        <%= t('Немає облікового запису?') %>
        <a href="/register"><%= t('Зареєструватися') %></a>
      </p>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
