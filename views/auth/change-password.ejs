<%- include('../partials/head', { title: 'Зміна пароля' }) %>
<%- include('../partials/nav') %>

<main class="container">
  <div class="page-title">
    <div>
      <h1>Змінити пароль</h1>
      <p>Встановіть новий пароль для свого облікового запису.</p>
    </div>
  </div>

  <section class="card narrow">
    <%- include('../partials/flash') %>

    <% if (currentUser.mustChangePassword) { %>
      <p class="notice">Перед продовженням встановіть власний пароль.</p>
    <% } %>

    <form method="post" action="/change-password" class="form-grid">
      <label>
        Поточний пароль
        <input type="password" name="currentPassword" required autocomplete="current-password">
      </label>

      <label>
        Новий пароль
        <input type="password" name="newPassword" minlength="8" required autocomplete="new-password">
      </label>

      <label>
        Повторіть новий пароль
        <input type="password" name="confirmPassword" minlength="8" required autocomplete="new-password">
      </label>

      <button class="primary" type="submit">Зберегти пароль</button>
    </form>
  </section>
</main>

<%- include('../partials/footer') %>
