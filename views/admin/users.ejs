<%- include('../partials/head', { title: t('Користувачі') }) %>
<%- include('../partials/nav') %>

<main class="container">
  <div class="page-title">
    <div>
      <h1><%= t('Користувачі') %></h1>
      <p><%= t(permissions.manageUsers ? 'Створення, вимкнення та повне видалення облікових записів.' : 'Перегляд облікових записів.') %></p>
    </div>
  </div>

  <%- include('../partials/flash') %>

  <% if (permissions.manageUsers) { %>
  <section class="card">
    <h2><%= t('Додати користувача') %></h2>
    <form method="post" action="/admin/users" class="form-row">
      <input name="fullName" placeholder="<%= t('ПІБ') %>" required>
      <input name="username" placeholder="<%= t('Логін') %>" required>
      <input type="password" name="password" minlength="8" placeholder="<%= t('Тимчасовий пароль') %>" required>
      <select name="role" aria-label="<%= t('Роль користувача') %>">
        <% Object.entries(roleLabels).forEach(([value, label]) => { %>
          <option value="<%= value %>"><%= t(label) %></option>
        <% }) %>
      </select>
      <button class="primary" type="submit"><%= t('Створити') %></button>
    </form>
  </section>
  <% } %>

  <section class="card table-wrap">
    <table>
      <thead>
        <tr>
          <th><%= t('Користувач') %></th>
          <th><%= t('Роль') %></th>
          <th><%= t('Стан') %></th>
          <th><%= t('Перший вхід') %></th>
          <th><%= t('Дії') %></th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(user => { %>
          <tr>
            <td>
              <a class="user-profile-link" href="/admin/users/<%= user.id %>"><strong><%= user.full_name %></strong></a>
              <div class="muted"><%= user.username %><%= user.email ? ' · ' + user.email : '' %></div>
            </td>
            <td><%= t(roleLabels[user.role] || user.role) %></td>
            <td><%= t(user.is_active ? 'Активний' : 'Вимкнений') %></td>
            <td><%= t(user.must_change_password ? 'Потрібна зміна пароля' : 'Пароль встановлено') %></td>
            <td class="actions">
              <a class="small-action-link" href="/admin/users/<%= user.id %>"><%= t(permissions.manageUsers ? 'Редагувати' : 'Переглянути') %></a>
              <% if (permissions.manageUsers) { %>
              <form method="post" action="/admin/users/<%= user.id %>/toggle">
                <button type="submit"><%= t(user.is_active ? 'Вимкнути' : 'Увімкнути') %></button>
              </form>
              <form method="post" action="/admin/users/<%= user.id %>/delete" data-confirm="<%= t('Повністю видалити користувача?') %>" onsubmit="return confirm(this.dataset.confirm)">
                <button class="danger" type="submit"><%= t('Видалити') %></button>
              </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
</main>

<%- include('../partials/footer') %>
