<%- include('../partials/head', { title: t('Користувач — {name}', { name: targetUser.full_name }) }) %>
<%- include('../partials/nav') %>

<main class="container">
  <div class="page-title">
    <div>
      <a class="back-link" href="/admin/users"><%= t('← До списку користувачів') %></a>
      <h1><%= targetUser.full_name %></h1>
      <p><%= t('Редагування профілю, ролі та параметрів входу.') %></p>
    </div>
  </div>

  <%- include('../partials/flash') %>

  <section class="card profile-card">
    <form method="post" action="/admin/users/<%= targetUser.id %>" class="form-grid">
      <div class="form-section-heading">
        <h2><%= t('Основна інформація') %></h2>
        <p class="muted"><%= t('Логін може змінювати лише адміністратор.') %></p>
      </div>

      <div class="profile-form-grid">
        <label>
          <%= t('ПІБ') %>
          <input name="fullName" value="<%= targetUser.full_name || '' %>" required maxlength="160">
        </label>

        <label>
          <%= t('Псевдонім') %>
          <input name="nickname" value="<%= targetUser.nickname || '' %>" maxlength="100" placeholder="<%= t('Як звертатися до користувача') %>">
        </label>

        <label>
          <%= t('Логін') %>
          <input name="username" value="<%= targetUser.username %>" required maxlength="80" autocomplete="off">
          <small class="field-hint"><%= t('Унікальне ім’я для входу в систему.') %></small>
        </label>

        <label>
          Email
          <input type="email" name="email" value="<%= targetUser.email || '' %>" maxlength="180">
        </label>

        <label>
          <%= t('Телефон') %>
          <input name="phone" value="<%= targetUser.phone || '' %>" maxlength="50">
        </label>

        <label>
          <%= t('Посада') %>
          <input name="position" value="<%= targetUser.position || '' %>" maxlength="120">
        </label>

        <label>
          <%= t('Відділ') %>
          <input name="department" value="<%= targetUser.department || '' %>" maxlength="120">
        </label>

        <label>
          <%= t('Кабінет / місце') %>
          <input name="office" value="<%= targetUser.office || '' %>" maxlength="100">
        </label>

        <label>
          <%= t('Роль') %>
          <select name="role">
            <% Object.entries(roleLabels).forEach(([value, label]) => { %>
              <option value="<%= value %>" <%= targetUser.role === value ? 'selected' : '' %>><%= t(label) %></option>
            <% }) %>
          </select>
        </label>

        <label>
          <%= t('Стан облікового запису') %>
          <select name="isActive">
            <option value="1" <%= targetUser.is_active ? 'selected' : '' %>><%= t('Активний') %></option>
            <option value="0" <%= !targetUser.is_active ? 'selected' : '' %>><%= t('Вимкнений') %></option>
          </select>
        </label>
      </div>

      <div class="form-section-heading password-section">
        <h2><%= t('Тимчасовий пароль') %></h2>
        <p class="muted"><%= t('Залиште поле порожнім, щоб не змінювати пароль.') %></p>
      </div>

      <label class="profile-password-field">
        <%= t('Новий тимчасовий пароль') %>
        <input type="password" name="temporaryPassword" minlength="8" autocomplete="new-password" placeholder="<%= t('Щонайменше 8 символів') %>">
        <small class="field-hint"><%= t('Після скидання користувач буде зобов’язаний змінити пароль під час наступного входу.') %></small>
      </label>

      <div class="form-actions">
        <button class="primary" type="submit"><%= t('Зберегти зміни') %></button>
        <a class="secondary-button button-link" href="/admin/users"><%= t('Скасувати') %></a>
      </div>
    </form>
  </section>
</main>

<%- include('../partials/footer') %>
